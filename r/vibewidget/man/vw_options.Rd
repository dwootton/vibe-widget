\name{vw_options}
\alias{vw_options}
\title{Read the engine's current configuration}
\usage{
vw_options()
}
\value{
A named list mirroring the Python engine's \code{Config} object (\code{model},
\code{api_key}, \code{temperature}, \code{mode}, \code{execution}, \code{retry}, ...).
}
\description{
Read the engine's current configuration.
}
