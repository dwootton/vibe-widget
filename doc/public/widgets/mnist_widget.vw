{
  "version": "1.0",
  "created_at": "2026-01-29T19:53:16.554459+00:00",
  "description": "Create a MNIST digit recognition widget with two-column layout:\n    LEFT SIDE is a Drawing Canvas:\n    - 28x28 drawing canvas scaled to 280x280px for visibility\n    - Mouse drag to draw with thick brush (3px)\n    - Clear and submit button\n    \n    RIGHT SIDE is a Prediction Display:\n    - Large predicted digit display (e.g., \"Predicted: 7\")\n    - Confidence percentage\n    - Horizontal bar chart showing all 10 digit probabilities (0-9)\n    - Highlight predicted digit's bar with percentage labels\n    \n    ",
  "code": "import * as d3 from \"https://esm.sh/d3@7\";\n\n/**\n * A standalone drawing canvas component for MNIST input.\n * Renders a 28x28 grid scaled to 280x280.\n * Improved to use line drawing for continuous strokes.\n */\nexport const DrawingCanvas = ({ model, React, width = 280, height = 280 }) => {\n  const canvasRef = React.useRef(null);\n  const [isDrawing, setIsDrawing] = React.useState(false);\n  const lastPos = React.useRef({ x: 0, y: 0 });\n\n  const getCanvasContext = () => {\n    const canvas = canvasRef.current;\n    if (!canvas) return null;\n    return canvas.getContext(\"2d\", { willReadFrequently: true });\n  };\n\n  React.useEffect(() => {\n    const ctx = getCanvasContext();\n    if (!ctx) return;\n    \n    // Initialize background to black (MNIST style)\n    ctx.fillStyle = \"black\";\n    ctx.fillRect(0, 0, 28, 28);\n    \n    // Line settings for smooth drawing\n    ctx.strokeStyle = \"white\";\n    ctx.lineWidth = 2.2;\n    ctx.lineCap = \"round\";\n    ctx.lineJoin = \"round\";\n  }, []);\n\n  const getCoordinates = (e) => {\n    const canvas = canvasRef.current;\n    const rect = canvas.getBoundingClientRect();\n    return {\n      x: ((e.clientX - rect.left) / rect.width) * 28,\n      y: ((e.clientY - rect.top) / rect.height) * 28\n    };\n  };\n\n  const handleMouseDown = (e) => {\n    setIsDrawing(true);\n    const pos = getCoordinates(e);\n    lastPos.current = pos;\n    \n    // Draw initial dot\n    const ctx = getCanvasContext();\n    if (!ctx) return;\n    ctx.beginPath();\n    ctx.fillStyle = \"white\";\n    ctx.arc(pos.x, pos.y, 1.1, 0, Math.PI * 2);\n    ctx.fill();\n  };\n\n  const handleMouseMove = (e) => {\n    if (!isDrawing) return;\n    const ctx = getCanvasContext();\n    if (!ctx) return;\n\n    const currentPos = getCoordinates(e);\n\n    ctx.beginPath();\n    ctx.moveTo(lastPos.current.x, lastPos.current.y);\n    ctx.lineTo(currentPos.x, currentPos.y);\n    ctx.stroke();\n\n    lastPos.current = currentPos;\n  };\n\n  const handleMouseUp = () => {\n    setIsDrawing(false);\n  };\n\n  const clearCanvas = () => {\n    const ctx = getCanvasContext();\n    if (!ctx) return;\n    ctx.fillStyle = \"black\";\n    ctx.fillRect(0, 0, 28, 28);\n  };\n\n  const submitDrawing = () => {\n    const ctx = getCanvasContext();\n    if (!ctx) return;\n\n    const imageData = ctx.getImageData(0, 0, 28, 28);\n    const pixels = new Array(784);\n    \n    // Convert RGBA to grayscale (just take Red channel since brush is white)\n    for (let i = 0; i < 784; i++) {\n      pixels[i] = imageData.data[i * 4];\n    }\n\n    const currentCount = model.get(\"submit_count\") || 0;\n    model.set(\"image_data\", pixels);\n    model.set(\"submit_count\", currentCount + 1);\n    model.save_changes();\n  };\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"12px\", alignItems: \"center\" }}>\n      <canvas\n        ref={canvasRef}\n        width={28}\n        height={28}\n        onMouseDown={handleMouseDown}\n        onMouseMove={handleMouseMove}\n        onMouseUp={handleMouseUp}\n        onMouseLeave={handleMouseUp}\n        style={{\n          width: width,\n          height: height,\n          imageRendering: \"pixelated\",\n          cursor: \"crosshair\",\n          border: \"2px solid #444\",\n          borderRadius: \"4px\",\n          boxShadow: \"0 4px 6px rgba(0,0,0,0.1)\"\n        }}\n      />\n      <div style={{ display: \"flex\", gap: \"8px\" }}>\n        <button \n          onClick={clearCanvas}\n          style={{\n            padding: \"8px 16px\",\n            backgroundColor: \"#f3f4f6\",\n            border: \"1px solid #d1d5db\",\n            borderRadius: \"4px\",\n            cursor: \"pointer\",\n            fontWeight: \"600\",\n            color: \"#374151\"\n          }}\n        >\n          Clear\n        </button>\n        <button \n          onClick={submitDrawing}\n          style={{\n            padding: \"8px 16px\",\n            backgroundColor: \"#2563eb\",\n            color: \"white\",\n            border: \"none\",\n            borderRadius: \"4px\",\n            cursor: \"pointer\",\n            fontWeight: \"600\"\n          }}\n        >\n          Predict Digit\n        </button>\n      </div>\n    </div>\n  );\n};\n\n/**\n * A standalone chart component for displaying model probabilities.\n */\nexport const ProbabilityChart = ({ model, React, width = 300, height = 240 }) => {\n  const containerRef = React.useRef(null);\n  const [prediction, setPrediction] = React.useState(null);\n\n  React.useEffect(() => {\n    const updatePrediction = () => {\n      const raw = model.get(\"prediction_result\");\n      if (!raw) return;\n      \n      try {\n        const parsed = typeof raw === 'string' && raw.includes('{') \n          ? JSON.parse(raw.replace(/^[^{]*/, '')) \n          : raw;\n        setPrediction(parsed);\n      } catch (e) {\n        console.error(\"Failed to parse prediction\", e);\n      }\n    };\n\n    model.on(\"change:prediction_result\", updatePrediction);\n    updatePrediction();\n    return () => model.off(\"change:prediction_result\", updatePrediction);\n  }, []);\n\n  React.useEffect(() => {\n    if (!containerRef.current || !prediction || !prediction.probabilities) return;\n\n    const data = prediction.probabilities.map((p, i) => ({ digit: i, prob: p }));\n    const margin = { top: 10, right: 40, bottom: 20, left: 30 };\n    const innerWidth = width - margin.left - margin.right;\n    const innerHeight = height - margin.top - margin.bottom;\n\n    d3.select(containerRef.current).selectAll(\"*\").remove();\n\n    const svg = d3.select(containerRef.current)\n      .append(\"svg\")\n      .attr(\"width\", width)\n      .attr(\"height\", height)\n      .append(\"g\")\n      .attr(\"transform\", `translate(${margin.left},${margin.top})`);\n\n    const y = d3.scaleBand()\n      .range([0, innerHeight])\n      .domain(data.map(d => d.digit))\n      .padding(0.2);\n\n    const x = d3.scaleLinear()\n      .domain([0, 1])\n      .range([0, innerWidth]);\n\n    svg.selectAll(\"rect\")\n      .data(data)\n      .enter()\n      .append(\"rect\")\n      .attr(\"y\", d => y(d.digit))\n      .attr(\"x\", 0)\n      .attr(\"height\", y.bandwidth())\n      .attr(\"width\", d => x(d.prob))\n      .attr(\"fill\", d => d.digit === prediction.digit ? \"#2563eb\" : \"#94a3b8\")\n      .attr(\"rx\", 2);\n\n    svg.selectAll(\".label\")\n      .data(data)\n      .enter()\n      .append(\"text\")\n      .attr(\"class\", \"label\")\n      .attr(\"y\", d => y(d.digit) + y.bandwidth() / 2 + 4)\n      .attr(\"x\", -10)\n      .attr(\"text-anchor\", \"end\")\n      .style(\"font-size\", \"12px\")\n      .style(\"font-weight\", \"bold\")\n      .style(\"fill\", \"#1f2937\")\n      .text(d => d.digit);\n\n    svg.selectAll(\".perc\")\n      .data(data)\n      .enter()\n      .append(\"text\")\n      .attr(\"class\", \"perc\")\n      .attr(\"y\", d => y(d.digit) + y.bandwidth() / 2 + 4)\n      .attr(\"x\", d => x(d.prob) + 5)\n      .style(\"font-size\", \"10px\")\n      .style(\"fill\", d => d.digit === prediction.digit ? \"#1e40af\" : \"#64748b\")\n      .style(\"font-weight\", d => d.digit === prediction.digit ? \"bold\" : \"normal\")\n      .text(d => (d.prob * 100).toFixed(1) + \"%\");\n\n  }, [prediction, width, height]);\n\n  if (!prediction) {\n    return (\n      <div style={{ width, height, display: \"flex\", alignItems: \"center\", justifyContent: \"center\", color: \"#1f2937\", border: \"1px dashed #94a3b8\", borderRadius: \"8px\", fontWeight: \"500\" }}>\n        Draw a digit and click Predict\n      </div>\n    );\n  }\n\n  return (\n    <div style={{ display: \"flex\", flexDirection: \"column\", gap: \"16px\" }}>\n      <div style={{ textAlign: \"center\" }}>\n        <div style={{ fontSize: \"14px\", color: \"#4b5563\", textTransform: \"uppercase\", letterSpacing: \"0.05em\", fontWeight: \"bold\" }}>Result</div>\n        <div style={{ fontSize: \"48px\", fontWeight: \"800\", color: \"#111827\", lineHeight: \"1\" }}>\n          {prediction.digit}\n        </div>\n        <div style={{ fontSize: \"16px\", fontWeight: \"700\", color: \"#2563eb\" }}>\n          {(prediction.confidence * 100).toFixed(1)}% Confidence\n        </div>\n      </div>\n      <div ref={containerRef} />\n    </div>\n  );\n};\n\nexport default function MNISTWidget({ model, React }) {\n  React.useEffect(() => {\n    if (model.get(\"submit_count\") === undefined) {\n      model.set(\"submit_count\", 0);\n    }\n    if (model.get(\"image_data\") === undefined) {\n      model.set(\"image_data\", new Array(784).fill(0));\n    }\n    model.save_changes();\n  }, []);\n\n  return (\n    <section style={{ \n      padding: \"24px\", \n      backgroundColor: \"#ffffff\", \n      minHeight: \"420px\",\n      fontFamily: \"system-ui, -apple-system, sans-serif\"\n    }}>\n      <div style={{ \n        display: \"grid\", \n        gridTemplateColumns: \"1fr 1fr\", \n        gap: \"40px\",\n        maxWidth: \"700px\",\n        margin: \"0 auto\",\n        alignItems: \"start\"\n      }}>\n        <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\" }}>\n          <h3 style={{ margin: \"0 0 16px 0\", color: \"#111827\", fontSize: \"18px\", fontWeight: \"bold\" }}>Draw Digit (0-9)</h3>\n          <DrawingCanvas model={model} React={React} />\n        </div>\n\n        <div style={{ display: \"flex\", flexDirection: \"column\", alignItems: \"center\" }}>\n          <h3 style={{ margin: \"0 0 16px 0\", color: \"#111827\", fontSize: \"18px\", fontWeight: \"bold\" }}>Model Prediction</h3>\n          <ProbabilityChart model={model} React={React} />\n        </div>\n      </div>\n    </section>\n  );\n}",
  "outputs": {
    "image_data": "array of 784 numbers (0-255) representing 28x28 grayscale image",
    "submit_count": "integer counter incremented on each submit"
  },
  "inputs_signature": {
    "prediction_result": "<input>"
  },
  "theme": null,
  "components": [
    "DrawingCanvas",
    "ProbabilityChart"
  ],
